// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  salt         String
  createdAt    DateTime @default(now())
}

model Device {
  id         String     @id @default(uuid()) @db.Uuid
  imei       String     @unique
  name       String?
  createdAt  DateTime   @default(now())
  positions  Position[]
  vehicles   Vehicle[]
  tripMerges TripMerge[]
  trips      Trip[]
}

model TripMerge {
  id           String   @id @default(uuid()) @db.Uuid
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId     String   @db.Uuid
  gapAfter     DateTime // last position of first segment (gap starts after this)
  gapBefore    DateTime // first position of second segment (gap ends before this)
  createdAt    DateTime @default(now())

  @@unique([deviceId, gapAfter, gapBefore])
  @@index([deviceId])
}

model Position {
  id         String   @id @default(uuid()) @db.Uuid
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId   String   @db.Uuid
  timestamp  DateTime
  latitude   Float
  longitude  Float
  speed      Float?
  attributes Json?    // OsmAnd/Traccar extras: accuracy, altitude, battery, activity, etc.
  createdAt  DateTime @default(now())

  @@index([deviceId])
  @@index([timestamp])
}

model Vehicle {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  licensePlate     String?
  vin              String?
  year             Int?
  make             String?
  model            String?
  currentOdometer  Int?
  fuelType         String?
  icon             String?
  photoPath        String?   // relative path under uploads/vehicles/
  deviceId         String?   @db.Uuid
  device           Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  thirdPartyInsuranceStart DateTime?
  thirdPartyInsuranceEnd   DateTime?
  ownInsuranceStart        DateTime?
  ownInsuranceEnd          DateTime?
  createdAt        DateTime  @default(now())
  maintenance      MaintenanceRecord[]
  fuelRecords      FuelRecord[]
  trips            Trip[]

  @@index([deviceId])
}

model Trip {
  id          String         @id @default(uuid()) @db.Uuid
  deviceId    String?        @db.Uuid  // required for source=device; null for imported
  device      Device?        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicleId   String?        @db.Uuid
  vehicle     Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  startTime   DateTime
  endTime     DateTime
  name        String?
  source      String         @default("device")  // "device" | "imported"
  createdAt   DateTime       @default(now())
  positions   TripPosition[] // only for source=imported
  stops       TripStop[]     // user-added stops (label, time range, location)

  @@index([deviceId])
  @@index([vehicleId])
  @@index([startTime])
}

model TripStop {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @db.Uuid
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  label       String
  startTime   DateTime
  endTime     DateTime?   // optional: stop has duration
  latitude    Float
  longitude   Float
  sortOrder   Int      @default(0)

  @@index([tripId])
}

model TripPosition {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @db.Uuid
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  timestamp DateTime
  speed     Float?
  sortOrder Int      @default(0)

  @@index([tripId])
}

model FuelRecord {
  id           String   @id @default(uuid()) @db.Uuid
  vehicleId    String   @db.Uuid
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date         DateTime
  odometer     Int
  fuelQuantity Float
  fuelCost     Float?
  fuelRate     Float?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())

  @@index([vehicleId])
  @@index([date])
}

model MaintenanceRecord {
  id          String   @id @default(uuid()) @db.Uuid
  vehicleId   String   @db.Uuid
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String
  notes       String?
  odometer    Int?
  cost        Float?   // optional cost in user's currency (LubeLogger-style)
  date        DateTime
  receiptPath String?  // relative path under uploads/maintenance/
  createdAt   DateTime @default(now())

  @@index([vehicleId])
  @@index([date])
}
