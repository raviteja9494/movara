# Local npm development uses DATABASE_URL. Docker deployments use .env.release.example and require DB_PASSWORD.
DATABASE_URL=postgresql://user:password@localhost:5432/movara
NODE_ENV=development
PORT=3000
JWT_SECRET=movara-dev-secret-change-in-production
ALLOW_REGISTRATION=false
SYSTEM_ADMIN_TOKEN=movara-dev-system-admin-token-change-me
SYSTEM_ADMIN_TOKEN=movara-dev-system-admin-token-change-me
GT06_PORT=5023
EELINK_PORT=5064
OSMAND_PORT=5055
PROTOCOL_DEBUG=true
