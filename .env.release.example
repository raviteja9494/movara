# Movara – production Docker deploy
# Copy to .env and set at least DB_PASSWORD (and optionally others).
# Used by: docker-compose.release.yml
# Backend and webui use PORT and WEBUI_PORT from the .env you create from this file.

# Database (required for Docker)
DB_USER=movara
DB_PASSWORD=changeme
DB_NAME=movara
DB_PORT=5432

# API server (backend listens on this port inside the container; host mapping uses it too)
NODE_ENV=production
PORT=3000

# Web UI – host port where the UI is reachable (container serves on 80; set this to change the public port)
WEBUI_PORT=8080

# Tracker protocols (open these on firewall if devices connect from internet)
# GT06_PORT=5051
# OSMAND_PORT=5055

# Database export (Settings) downloads a .sql.gz file directly to your browser (like Export GPX).
# Import database replaces the database completely with the uploaded backup; old data is removed.

# Image tag when using pre-built images (default: latest)
# MOVARA_TAG=latest
