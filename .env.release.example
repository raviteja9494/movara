# Movara – Docker deploy (used by docker-compose.yml and docker-compose.release.yml)
# Copy this file to .env and set DB_PASSWORD, JWT_SECRET, and SYSTEM_ADMIN_TOKEN.
# PostgreSQL is internal-only unless the optional development override is used.

# Database - DB_PASSWORD is required; use a strong, unique value.
DB_USER=movara
DB_PASSWORD=
DB_NAME=movara
# Optional local-only database access with docker-compose.db-access.yml:
# DB_PORT=5432

# API – host port for the backend API (default 3000). Use this if 3000 is already in use.
NODE_ENV=production
PORT=3000

# Auth - required in production. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=
# First user can always register. Set true only while intentionally adding more users.
ALLOW_REGISTRATION=false
# Separate operator credential for backup/restore/settings/log/clear routes.
# Generate another unique value with: openssl rand -hex 32
SYSTEM_ADMIN_TOKEN=
# Separate operator credential for backup/restore/settings/log/clear routes.
# Generate another unique value with: openssl rand -hex 32
SYSTEM_ADMIN_TOKEN=

# Web UI – host port for the browser (default 8080). Use this if 8080 is already in use.
WEBUI_PORT=8080

# Tracker protocols – host ports (uncomment and change if needed; open on firewall for devices)
GT06_PORT=5023
EELINK_PORT=5064
OSMAND_PORT=5055

# Optional protocol debug file logging (runtime toggle; restart app after changing)
PROTOCOL_DEBUG=true
PROTOCOL_DEBUG_DIR=/app/protocol-logs

# Database export (Settings) downloads a .sql.gz file directly to your browser (like Export GPX).
# Import database replaces the database completely with the uploaded backup; old data is removed.

# Image tag when using pre-built images (default: latest)
# MOVARA_TAG=latest
