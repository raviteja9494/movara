# Movara – Docker deploy (used by docker-compose.yml and docker-compose.release.yml)
# Copy this file to .env and set at least DB_PASSWORD.
# To use different ports, set the variables below; the host will expose these ports.

# Database – host port for PostgreSQL (default 5432)
DB_USER=movara
DB_PASSWORD=changeme
DB_NAME=movara
DB_PORT=5432

# API – host port for the backend API (default 3000). Use this if 3000 is already in use.
NODE_ENV=production
PORT=3000

# Web UI – host port for the browser (default 8080). Use this if 8080 is already in use.
WEBUI_PORT=8080

# Tracker protocols – host ports (uncomment and change if needed; open on firewall for devices)
GT06_PORT=5023
EELINK_PORT=5064
OSMAND_PORT=5055

# Optional protocol debug file logging (runtime toggle; restart app after changing)
PROTOCOL_DEBUG=true
PROTOCOL_DEBUG_DIR=/app/protocol-logs

# Database export (Settings) downloads a .sql.gz file directly to your browser (like Export GPX).
# Import database replaces the database completely with the uploaded backup; old data is removed.

# Image tag when using pre-built images (default: latest)
# MOVARA_TAG=latest
