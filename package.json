{
  "name": "movara",
  "version": "1.3.0",
  "description": "Self-hosted vehicle telemetry and lifecycle platform (API-only)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" && npm --prefix webui run lint",
    "build": "tsc",
    "start": "node dist/main.js",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.8.0",
    "fastify": "^4.25.2",
    "file-type": "^16.5.4",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "eslint": "^10.8.1",
    "prisma": "^5.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.66.0"
  }
}
